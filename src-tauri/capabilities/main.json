{
  "identifier": "main-window",
  "description": "Window controls for the bundled flight interface.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-world-save",
    "allow-world-list",
    "allow-world-read",
    "allow-world-remove",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-close",
    "allow-pack-begin",
    "allow-pack-put",
    "allow-pack-finish",
    "allow-pack-abort",
    "allow-pack-list",
    "allow-pack-read",
    "allow-pack-remove",
    "allow-pack-verify",
    "allow-official-pack-install",
    "allow-official-pack-progress",
    "allow-official-pack-cancel",
    "allow-desktop-release",
    "allow-desktop-open-release",
    "allow-desktop-choose-library",
    "allow-desktop-environment"
  ]
}

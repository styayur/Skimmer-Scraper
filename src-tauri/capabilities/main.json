{
  "identifier": "main-window",
  "description": "Window controls for the bundled flight interface.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-world-save",
    "allow-world-list",
    "allow-world-read",
    "allow-world-remove",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "allow-pack-begin",
    "allow-pack-put",
    "allow-pack-finish",
    "allow-pack-abort",
    "allow-pack-list",
    "allow-pack-read",
    "allow-pack-remove"
  ]
}
